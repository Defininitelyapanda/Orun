# Runtime
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://orun:change-me@localhost:5432/orun
AUTH_SECRET=replace-with-at-least-32-random-characters
ADMIN_MFA_ENCRYPTION_KEY=replace-with-a-separate-32-character-encryption-key
CMS_SCHEDULER_SECRET=replace-with-a-random-scheduler-token
PLAYBACK_SIGNING_SECRET=replace-with-at-least-32-random-characters
CDN_URL=https://media.example.com
HEALTHCHECK_TOKEN=replace-with-a-random-operations-token
SECURITY_INGEST_SECRET=replace-with-a-random-security-ingest-token
ANALYTICS_ROLLUP_SECRET=replace-with-a-random-analytics-rollup-token

# Queue and media processing
REDIS_URL=redis://localhost:6379
MEDIA_WORKER_ID=orun-media-worker-1
MEDIA_WORKER_CONCURRENCY=2
MEDIA_SCAN_COMMAND=clamscan
MEDIA_INPUT_ROOT=C:/orun-media/input
MEDIA_OUTPUT_ROOT=C:/orun-media/output
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=orun-private-media
STORAGE_ACCESS_KEY=replace-me
STORAGE_SECRET_KEY=replace-me

# Transactional email
EMAIL_API_URL=https://email-provider.example/v1
EMAIL_API_KEY=replace-me
EMAIL_FROM=no-reply@example.com

# Transactional SMS (required for phone verification)
SMS_API_URL=https://sms-provider.example/v1/messages
SMS_API_KEY=replace-me
SMS_FROM=ORUN

# M-Pesa
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=replace-me
MPESA_CONSUMER_SECRET=replace-me
MPESA_SHORTCODE=replace-me
MPESA_PASSKEY=replace-me
MPESA_CALLBACK_URL=https://example.com/api/webhooks/mpesa

# Card processor
CARD_BASE_URL=https://card-provider.example/v1
CARD_SECRET=replace-me
CARD_WEBHOOK_SECRET=replace-me

# Explicit, one-time owner bootstrap; omit during normal operation
ORUN_OWNER_EMAIL=owner@example.com
ORUN_OWNER_NAME=ORUN Owner
ORUN_OWNER_PASSWORD=replace-with-a-one-time-password-of-at-least-12-characters
